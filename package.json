{
  "name": "demo-clickjacking",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:victim": "pnpm --filter victim dev",
    "dev:attacker": "pnpm --filter attacker dev",
    "build": "echo \"No build step: servers run directly via Node's TypeScript stripping.\"",
    "typecheck": "tsc",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "pnpm -r --no-bail test"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2"
  },
  "packageManager": "pnpm@11.18.0"
}
